APP_ENV=development
LOG_SENSITIVE_CONTENT=false

# If this repo lives inside a OneDrive/Dropbox/etc-synced folder, point this outside that
# tree instead (e.g. %LOCALAPPDATA%\ArchLens\data on Windows) -- cloud sync clients can
# interfere with SQLite's WAL sidecar files and cause spurious "database is locked" errors.
ARCHLENS_DATA_DIR=./data
MAX_UPLOAD_BYTES=20971520

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
OLLAMA_THINK=false

ANN_ENABLED=true
ANN_MIN_VECTORS=500

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute

# Notion export: internal integration token from Notion -> My Integrations.
# The target page/database must also be shared with that integration inside Notion itself --
# the token alone does not grant access to anything.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# GitHub code intelligence (read-only): a fine-grained personal access token,
# repository access "All repositories", permission Contents: Read-only, nothing else.
# Single-user tool -- one token for your own account, no per-user OAuth.
GITHUB_READ_TOKEN=
